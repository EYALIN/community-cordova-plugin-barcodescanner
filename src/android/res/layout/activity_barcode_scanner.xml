<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay - Top -->
    <View
        android:id="@+id/overlay_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintBottom_toTopOf="@id/scan_area"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay - Bottom -->
    <View
        android:id="@+id/overlay_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scan_area" />

    <!-- Overlay - Left -->
    <View
        android:id="@+id/overlay_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="@id/scan_area"
        app:layout_constraintEnd_toStartOf="@id/scan_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/scan_area" />

    <!-- Overlay - Right -->
    <View
        android:id="@+id/overlay_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="@id/scan_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/scan_area"
        app:layout_constraintTop_toTopOf="@id/scan_area" />

    <!-- Scan Area with rounded corners -->
    <View
        android:id="@+id/scan_area"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/rounded_rectangle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Corner indicators - Top Left -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="@id/scan_area"
        app:layout_constraintTop_toTopOf="@id/scan_area" />

    <View
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="@id/scan_area"
        app:layout_constraintTop_toTopOf="@id/scan_area" />

    <!-- Corner indicators - Top Right -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@id/scan_area"
        app:layout_constraintTop_toTopOf="@id/scan_area" />

    <View
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@id/scan_area"
        app:layout_constraintTop_toTopOf="@id/scan_area" />

    <!-- Corner indicators - Bottom Left -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/scan_area"
        app:layout_constraintStart_toStartOf="@id/scan_area" />

    <View
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/scan_area"
        app:layout_constraintStart_toStartOf="@id/scan_area" />

    <!-- Corner indicators - Bottom Right -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/scan_area"
        app:layout_constraintEnd_toEndOf="@id/scan_area" />

    <View
        android:layout_width="4dp"
        android:layout_height="40dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/scan_area"
        app:layout_constraintEnd_toEndOf="@id/scan_area" />

    <!-- Prompt Text -->
    <TextView
        android:id="@+id/prompt_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:background="#80000000"
        android:text="Point the camera at a barcode"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scan_area" />

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/close_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Torch Button -->
    <ImageButton
        android:id="@+id/torch_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Toggle Flashlight"
        android:src="@android:drawable/ic_menu_compass"
        android:tint="#FFFFFF"
        android:alpha="0.6"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- APP-225: Done button - only shown/populated when the JS side passes doneButtonLabel
         (batch scan mode). Lets the user end a batch run from inside this native, one-shot-per-code
         overlay, where the Ionic page's own Stop button (and the running count behind it) is
         hidden. GONE by default so every pre-existing, non-batch call site is unaffected. -->
    <Button
        android:id="@+id/done_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/done_button_background"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Done"
        android:textColor="#000000"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
